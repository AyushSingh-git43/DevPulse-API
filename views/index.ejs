<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register Form</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="w-full min-h-screen bg-zinc-700 flex items-center justify-center m-0">

    <form action="/register" method="POST" class="bg-zinc-800 p-8 rounded-lg shadow-lg flex flex-col gap-4 w-96">
        <h2 class="text-white text-2xl font-bold mb-2">Create Account</h2>
        
        <input class="px-4 py-2 rounded bg-zinc-700 text-white border border-zinc-600 focus:outline-none focus:border-blue-500" type="text" placeholder="Full Name" name="name">
        
        <input class="px-4 py-2 rounded bg-zinc-700 text-white border border-zinc-600 focus:outline-none focus:border-blue-500" type="text" placeholder="Username" name="username">
        
        <input class="px-4 py-2 rounded bg-zinc-700 text-white border border-zinc-600 focus:outline-none focus:border-blue-500" type="number" placeholder="Age" name="age">
        
        <input class="px-4 py-2 rounded bg-zinc-700 text-white border border-zinc-600 focus:outline-none focus:border-blue-500" type="email" placeholder="Email" name="email">
        
        <input class="px-4 py-2 rounded bg-zinc-700 text-white border border-zinc-600 focus:outline-none focus:border-blue-500" type="password" placeholder="Password" name="password">
        
        <input type="submit" value="Register" class="bg-blue-600 text-white py-2 rounded font-semibold cursor-pointer hover:bg-blue-500 transition">
    </form>

</body>
</html>